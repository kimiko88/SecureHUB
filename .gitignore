# ==============================================================================
# SECUREUSB / SECUREHUB — ROOT .GITIGNORE (Go + Rust Multi-Platform Architecture)
# ==============================================================================

# Protegge esplicitamente il workspace Rust anche su filesystem case-insensitive (Windows NTFS)
!/secureusb-rs/
!/secureusb-rs/**

# ------------------------------------------------------------------------------
# 1. ARTEFATTI DI BUILD & RELEASE (Go & Rust)
# ------------------------------------------------------------------------------
/dist/
/release-assets/
/build/
/bin/

# Eseguibili e librerie compilate
*.exe
*.exe~
*.dll
*.pyd
*.lib
*.pdb
*.exp
*.so
*.dylib
*.a

# Binari Go compilati nella root (senza wildcard che catturino secureusb-rs)
/secureusb
/secureusb-linux
/secureusb-linux-amd64
/secureusb-mac
/secureusb-macos
/secureusb-go-*

# ------------------------------------------------------------------------------
# 2. RUST / CARGO BUILD TARGETS
# ------------------------------------------------------------------------------
**/target/
/secureusb-rs/target/
/secureusb-rs/fuzz/target/
**/*.rs.bk
*.rs.bk
Cargo.lock.orig

# ------------------------------------------------------------------------------
# 3. FUZZING & BENCHMARKING (Go Native Fuzz + cargo-fuzz + Criterion)
# ------------------------------------------------------------------------------
**/fuzz/artifacts/
**/fuzz/corpus/
fuzz_crash_*
crash-*
leak-*
timeout-*
oom-*
testdata/fuzz/

# ------------------------------------------------------------------------------
# 4. GO TEST & COVERAGE
# ------------------------------------------------------------------------------
*.test
*.out
cover.out
coverage.html
*.pprof

# ------------------------------------------------------------------------------
# 5. TEST VAULT & FILE TEMPORANEI
# ------------------------------------------------------------------------------
.secure_vault/
**/.secure_vault/
*.tmp
*.tmp.*
*.bin.tmp*
/mnt/secureusb*
/tmp/secureusb_mount*

# ------------------------------------------------------------------------------
# 6. IDE, EDITOR & SISTEMA OPERATIVO
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace
.idea/
*.iws
*.iml
*.ipr
.*.swp
.*.swo
*~
*.bak
*.gch
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

generate_*